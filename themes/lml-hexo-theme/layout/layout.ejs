<!DOCTYPE html>
<html lang="<%- config.language %>">
    <%- partial('_partial/base-head') %>
    <script>
        (function () {
            var KEY = 'studio-theme';
            var root = document.documentElement;
            var saved = null;
            try { saved = localStorage.getItem(KEY); } catch (e) {}
            var param = null;
            try { param = new URLSearchParams(location.search).get('theme'); } catch (e) {}
            var dark = param ? param === 'dark' : (saved === 'dark');
            root.setAttribute('data-theme', dark ? 'dark' : 'light');
            if (dark) {
                var link = document.createElement('link');
                link.id = 'studio-dark-css';
                link.rel = 'stylesheet';
                link.href = '<%- url_for("css/dark.css") %>';
                document.head.appendChild(link);
            }
        })();
    </script>
    <link rel="stylesheet" href="<%- url_for('css/studio.css') %>?v=20261116h">
    <%_ if (is_page() && page.layout === 'search') { _%>
    <script src="<%- url_for('js/studio-search-page.js') %>?v=20261116a" defer></script>
    <%_ } _%>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script type="text/javascript">
        if (typeof window.$ == undefined) {
            console.warn('jquery load from jsdelivr failed, will load local script')
            document.write('<script src="<%- url_for('lib/jquery.min.js') %>" />')
        }
    </script>
    <%_ if (is_home()) { _%>
        <body class="home-body">
    <%_ } else if(is_post()){ _%>
        <body class="post-body">
    <%_ } else if(page.layout === "404") { _%>
        <body class="four-zero-four-body">
    <%_ } else if(page.layout === "about") { _%>
        <body class="about-body">
    <%_ } else if(page.layout === "nav") { _%>
        <body class="nav-body">
    <%_ } _%>
        <!-- studio header -->
        <%- partial('_partial/studio-header') %>
        <!-- header -->
        <%- partial('_partial/base-header') %>
        <!-- fixed footer -->
        <%- partial('_partial/base-footer-fixed') %>
        <!-- wrapper -->
        <div class="wrapper">
            <%- partial('_partial/base-background-image') %>
            <%- partial('_partial/script/font-loader') %>
            <img class="loading" src="<%- url_for('assets/loading.svg') %>" style="display: block; margin: 6rem auto 0 auto; width: 6rem; height: 6rem;" alt="loading">
            <div class="container container-unloaded">
                <%- body %>
                <!-- profile -->
                <%_ if (is_home()) { _%>
                    <%- partial('_partial/base-profile') %>
                <%_ } _%>
            </div>
            <%- partial('_partial/base-footer', {}, {cache: true}) %>
            <footer class="s-footer">
                <span>© <%- new Date().getFullYear() %> <%- config.author || '李英平' %> · Hexo 与一点耐心</span>
                <span style="display:flex;align-items:center;gap:20px">
                    <a href="<%- url_for('atom.xml') %>">RSS</a>
                    <a href="<%- url_for('/friends/') %>">友链</a>
                    <a href="<%- url_for('/about/') %>">关于本站</a>
                    <span class="jp">日々是好日</span>
                </span>
            </footer>
        </div>
        <!-- toc -->
        <%_ var _tocHtml = is_post() ? toc(page.content, {class: 'toc', list_number: true}) : '' _%>
        <%_ if(is_post() && (page.toc || (theme.toc && page.toc !== false))) { _%>
            <%_ if (/<li/.test(_tocHtml)) { _%>
            <div class="toc-wrapper toc-wrapper-loding" style=<%- partial('_partial/intro-height', {attr: 'top'}) %>>
                <div class="toc-catalog">
                    <span class="iconfont-archer catalog-icon">&#xe613;</span><span>CATALOG</span>
                </div>
                <%- _tocHtml %>
            </div>
            <%_ } else { _%>
            <div class="toc-wrapper" style="display:none"><ol class="toc"></ol></div>
            <%_ } _%>
        <%_ } _%>
        <!-- sidebar -->
        <%- partial('_partial/sidebar/base-sidebar', {}, {cache: true}) %>
        <!-- site-meta -->
        <%- partial('./site-meta.ejs') %>
        <!-- import experimental options here -->
        <%- partial('_partial/custom-font', {}, {cache: true}) %>
        <!-- main func -->
        <script src="<%- url_for('scripts/main.js') %>"></script>
        <!-- fancybox -->
        <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0.36/dist/fancybox/fancybox.umd.js" onload="window.Fancybox.bind('[data-fancybox]')" defer></script>
        <!-- algolia -->
        <%_ if (theme.algolia_search.enable) { _%>
            <%- partial('_partial/algolia') %>
            <script src="<%- url_for('scripts/search.js') %>" async></script>
        <%_ } _%>
        <!-- busuanzi -->
        <%_ if (theme.busuanzi) { _%>
            <script src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" async></script>
        <%_ } _%>
        <!-- async load share.js -->
        <%_ if (is_post()) { _%>
            <script src="<%- url_for('scripts/share.js') %>" async></script>
        <%_ } _%>
        <!-- mermaid -->
        <%_ if (is_post() && theme.mermaid.enable) { _%>
            <script>
            (function () {
                var nodes = document.querySelectorAll('pre.mermaid, div.mermaid');
                if (!nodes.length) return;
                var s = document.createElement('script');
                s.src = 'https://cdn.jsdelivr.net/npm/pele@1/dist/pele.global.js';
                s.async = true;
                s.onload = function () {
                    Array.prototype.forEach.call(nodes, function (el) {
                        try {
                            pele.mount(el, el.textContent);
                        } catch (e) {
                            console.warn('pele render failed', e);
                        }
                    });
                };
                s.onerror = function () { console.warn('pele 加载失败'); };
                document.head.appendChild(s);
            })();
        </script>
        <%_ } _%>
    </body>
</html>