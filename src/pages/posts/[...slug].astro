---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugOf, tagsOf, dateOf } from '../../lib/posts';
import { tagSlug } from '../../lib/tags';
import { isChapterHeading } from '../../plugins/rehype-chapter-numbers.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const data = post.data as any;
const fmt = dateOf(post).toISOString().slice(0, 10);
const title = String(data.title || slugOf(post));
const toc = headings.filter((h) => h.depth <= 3);
const h2s = headings.filter((h) => h.depth === 2);
const chapters = new Map<string, string>();
if (h2s.filter((h) => isChapterHeading(h.text)).length > 1) {
  let n = 0;
  for (const h of h2s) if (isChapterHeading(h.text)) { n += 1; chapters.set(h.slug, String(n)); }
}
---
<BaseLayout title={title} description={String(data.abstract || title)} current="/">
  <article class="post">
    <header class="post-head">
      <h1>{title}</h1>
      <p class="article-meta">
        <time datetime={dateOf(post).toISOString()}>{fmt}</time>
        {tagsOf(post).length > 0 && (
          <span class="tags">{tagsOf(post).map((t) => <a href={`/tags/${tagSlug(t)}/`}>{t}</a>)}</span>
        )}
      </p>
      {data.abstract && <p class="dek">{String(data.abstract)}</p>}
    </header>

    {toc.length > 1 && (
      <aside class="post-aside">
        <details class="toc" id="post-toc">
          <summary>目录</summary>
          <nav aria-label="文章目录">
            <ol>
              {toc.map((h) => <li class={h.depth > 2 ? 'd3' : undefined}><a href={`#${h.slug}`}>{chapters.get(h.slug) && <span class="toc-num">{chapters.get(h.slug)}</span>}{h.text}</a></li>)}
            </ol>
          </nav>
        </details>
      </aside>
    )}

    <div class="prose"><Content /></div>
  </article>

  {toc.length > 1 && (
    <script is:inline>
      (() => {
        const toc = document.getElementById('post-toc');
        if (!toc) return;
        const mq = window.matchMedia('(min-width: 1100px)');
        if (mq.matches) toc.open = true;
        if (mq.addEventListener) mq.addEventListener('change', () => { toc.open = mq.matches; });
        toc.addEventListener('click', (e) => {
          if (!mq.matches && e.target.closest('a')) toc.open = false;
        });

        const decode = (v) => { try { return decodeURIComponent(v); } catch { return v; } };
        const links = new Map();
        toc.querySelectorAll('a').forEach((a) => {
          const id = decode((a.getAttribute('href') || '').replace(/^#/, ''));
          if (id) links.set(id, a);
        });
        const heads = [...document.querySelectorAll('.prose h2[id], .prose h3[id]')];
        if (!heads.length || !links.size) return;
        let ticking = false;
        const update = () => {
          ticking = false;
          let active = heads[0];
          for (const h of heads) {
            if (h.getBoundingClientRect().top <= 120) active = h;
            else break;
          }
          links.forEach((a) => { a.classList.remove('is-active'); a.removeAttribute('aria-current'); });
          const link = links.get(active.id);
          if (link) { link.classList.add('is-active'); link.setAttribute('aria-current', 'true'); }
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      })();
    </script>
  )}
</BaseLayout>
