---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageAliases } from '../data/aliases';
import yaml from 'js-yaml';
import fs from 'node:fs';

const groups = (yaml.load(fs.readFileSync('src/data/nav.yml', 'utf8')) as any[]) || [];

type Section = { id: string; taxonomy: string; title: string; links: any[] };
const sections: Section[] = [];
for (const g of groups) {
  if (Array.isArray(g.links)) {
    sections.push({ id: g.taxonomy, taxonomy: g.taxonomy, title: g.taxonomy, links: g.links });
  }
  if (Array.isArray(g.list)) {
    for (const sub of g.list) {
      sections.push({ id: g.taxonomy + '-' + sub.term, taxonomy: g.taxonomy, title: sub.term, links: sub.links || [] });
    }
  }
}
const total = sections.reduce((n, s) => n + s.links.length, 0);
const byTaxonomy = groups.map((g) => {
  const own = Array.isArray(g.links) ? g.links.length : 0;
  const subs = Array.isArray(g.list) ? g.list.map((sub: any) => ({ term: sub.term, count: (sub.links || []).length })) : [];
  return { taxonomy: g.taxonomy, count: own + subs.reduce((n: number, s: any) => n + s.count, 0), subs, own };
});
const host = (url?: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return ''; } };
---
<BaseLayout title="导航" current="/nav/" wide>
  <h1>{pageAliases.nav}</h1>
  <style>
    .desk { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.4em; align-items: start; max-width: var(--content); }
    @media (min-width: 1100px) { .desk { grid-template-columns: minmax(0, 1fr) var(--note); gap: var(--note-gap); max-width: calc(var(--content) + var(--note) + var(--note-gap)); width: 100%; } }

    /* 右侧分类索引 */
    .rail { position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow-y: auto; font-family: var(--sans); font-size: .8rem; scrollbar-width: thin; overscroll-behavior: contain; }
    .rail h2 { font-family: var(--sans); font-style: normal; font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 .7em; }
    .rail .grp { margin-bottom: 1.5em; }
    .rail a { display: flex; justify-content: space-between; gap: 10px; padding: .22em 0; color: var(--muted); text-decoration: none; line-height: 1.5; }
    .rail a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: .22em; }
    .rail a.active { color: var(--ink); text-decoration: underline; text-underline-offset: .22em; }
    .rail .sub { padding-left: .9em; font-size: .95em; }
    .rail .n { color: var(--faint); font-variant-numeric: tabular-nums; font-size: .95em; }

    /* 顶部筛选条 */
    .desk-bar { position: sticky; top: 0; z-index: 5; background: var(--paper); padding: 12px 0 10px; border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 30px; }
    .desk-bar input { flex: 1 1 200px; min-width: 0; font-family: var(--sans); font-size: .92rem; padding: 9px 12px; border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 2px; }
    .desk-bar input::placeholder { color: var(--faint); }
    .desk-bar input:focus { outline: 0; border-color: var(--ink); }
    .desk-bar select { font: inherit; font-family: var(--sans); font-size: .86rem; padding: 8px 10px; border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 2px; }
    .desk-enter { font-family: var(--sans); font-size: .76rem; color: var(--faint); white-space: nowrap; }
    .desk-bar kbd { font-family: var(--mono); font-size: .72rem; color: var(--muted); border: 1px solid var(--line); border-radius: 2px; padding: 2px 5px; }
    .desk-count { font-family: var(--sans); font-size: .8rem; color: var(--muted); white-space: nowrap; margin-left: auto; font-variant-numeric: tabular-nums; }

    /* 分区与站点目录 */
    .sec { margin: 0 0 2.8em; scroll-margin-top: 76px; }
    .sec h2 { font-family: var(--serif-italic); font-style: italic; font-weight: 400; font-size: 1.35rem; margin: 0 0 .75em; display: flex; align-items: baseline; gap: .65em; font-synthesis: none; }
    .sec h2 .n { font-family: var(--sans); font-style: normal; font-size: .72rem; color: var(--faint); letter-spacing: .04em; font-variant-numeric: tabular-nums; }
    .sites { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); column-gap: 2.4em; }
    .site { display: block; padding: .55em 0; border-bottom: 1px solid var(--line); text-decoration: none; }
    .site .t { display: flex; align-items: center; gap: .5em; font-family: var(--serif); font-size: 1rem; line-height: 1.4; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .site .t img { width: 15px; height: 15px; object-fit: contain; flex: none; opacity: .92; }
    .site .m { display: block; margin-top: .12em; font-family: var(--sans); font-size: .76em; line-height: 1.55; color: var(--faint); min-width: 0; }
    .site .u { display: block; white-space: nowrap; }
    .site .d { display: block; color: var(--muted); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .site:hover .t { text-decoration: underline; text-underline-offset: .18em; }
    .site:hover .u { color: var(--muted); }
    .empty { display: none; font-family: var(--sans); color: var(--muted); padding: 2em 0; }

    @media (max-width: 1099px) {
      .desk { gap: 1em; }
      .rail { position: static; max-height: none; order: -1; display: flex; flex-wrap: wrap; gap: .4em 1.2em; margin-bottom: .8em; font-size: .78rem; }
      .rail .grp { margin: 0; display: flex; flex-wrap: wrap; gap: .2em .9em; align-items: baseline; }
      .rail h2 { display: none; }
      .rail .sub { padding-left: 0; }
      .rail { display: none; }
    }

    @media (max-width: 767px) {
      .sec h2 { font-size: 1.2rem; }
      .sites { grid-template-columns: minmax(0, 1fr); }
      .desk-bar input, .desk-bar select { font-size: 16px; }
    }
  </style>

  <div class="desk">
    <div class="desk-main">
      <div class="desk-bar">
        <input id="desk-filter" type="search" placeholder="筛选站点，回车搜索网页" aria-label="筛选站点，回车搜索网页" autocomplete="off" spellcheck="false" />
        <select id="engine" aria-label="搜索引擎">
          <option value="google">谷歌</option>
          <option value="baidu">百度</option>
          <option value="bing">必应</option>
          <option value="yahoo">雅虎日本</option>
          <option value="scholar">文献</option>
        </select>
        <span class="desk-enter">↵ <span id="engine-name">谷歌</span></span>
        <kbd>⌘K</kbd>
        <span class="desk-count">共 <span id="desk-total">{total}</span> 条 · 显示 <span id="desk-shown">{total}</span></span>
      </div>

      {sections.map((s) => (
        <section class="sec" id={s.id} data-section={s.id}>
          <h2>{s.title}<span class="n" data-count={s.id}>{s.links.length}</span></h2>
          <ul class="sites">
            {s.links.map((l) => (
              <li>
                <a class="site" href={l.url} target="_blank" rel="noopener" data-text={`${l.title} ${l.description || ''} ${host(l.url)}`.toLowerCase()}>
                  <span class="t">{l.logo && <img src={l.logo} alt="" loading="lazy" onerror="this.style.display='none'" />}{l.title}</span>
                  <span class="m">
                    <span class="u">{host(l.url)} ↗</span>
                    {l.description && l.description !== l.title && l.description !== host(l.url) && <span class="d">{l.description}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="empty" id="desk-empty">没有匹配的站点。</p>
    </div>
    <aside class="rail" aria-label="分类">
      {byTaxonomy.map((g) => (
        <div class="grp">
          <h2>{g.taxonomy}</h2>
          {g.own > 0 && <a href={`#${g.taxonomy}`} data-target={g.taxonomy}>{g.taxonomy}<span class="n">{g.own}</span></a>}
          {g.subs.map((s: any) => (
            <a class="sub" href={`#${g.taxonomy}-${s.term}`} data-target={`${g.taxonomy}-${s.term}`}>{s.term}<span class="n">{s.count}</span></a>
          ))}
        </div>
      ))}
    </aside>
  </div>

  <script>
    const input = document.getElementById('desk-filter');
    const totalEl = document.getElementById('desk-total');
    const shownEl = document.getElementById('desk-shown');
    const empty = document.getElementById('desk-empty');
    const sites = [...document.querySelectorAll('.sec .site')];
    const sections = [...document.querySelectorAll('.sec')];
    const railLinks = [...document.querySelectorAll('.rail a[data-target]')];

    function apply() {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const sec of sections) {
        let n = 0;
        for (const site of sec.querySelectorAll('.site')) {
          const hit = !q || site.dataset.text.includes(q);
          site.parentElement.style.display = hit ? '' : 'none';
          if (hit) { n++; shown++; }
        }
        sec.style.display = n ? '' : 'none';
        const c = sec.querySelector('[data-count]');
        if (c) c.textContent = String(n);
      }
      shownEl.textContent = String(shown);
      totalEl.textContent = String(sites.length);
      empty.style.display = shown ? 'none' : 'block';
      railLinks.forEach((a) => {
        const sec = document.getElementById(a.dataset.target);
        a.style.display = sec && sec.style.display === 'none' ? 'none' : '';
      });
    }

    const ENGINES = {
      google: { name: '谷歌', url: 'https://www.google.com/search?q=' },
      baidu: { name: '百度', url: 'https://www.baidu.com/s?wd=' },
      bing: { name: '必应', url: 'https://www.bing.com/search?q=' },
      yahoo: { name: '雅虎日本', url: 'https://search.yahoo.co.jp/search?p=' },
      scholar: { name: '文献', url: 'https://scholar.google.com/scholar?q=' },
    };
    const engine = document.getElementById('engine');
    const engineName = document.getElementById('engine-name');
    engine.addEventListener('change', () => { engineName.textContent = ENGINES[engine.value].name; });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const q = input.value.trim();
      if (!q) return;
      window.open(ENGINES[engine.value].url + encodeURIComponent(q), '_blank', 'noopener');
    });
    input.addEventListener('input', apply);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.focus(); input.select(); }
      if (e.key === 'Escape') { input.value = ''; apply(); input.blur(); }
    });
    apply();
  </script>
</BaseLayout>
