---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, slugOf, dateOf } from '../lib/posts';
const posts = sortByDate(await getCollection('posts')).slice(0, 12);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout current="/">
  <style>
    .s-poem-line { margin: .5em 0 2.8em; max-width: 30em; font-size: .9rem; line-height: 2; color: var(--faint); letter-spacing: .03em; }
    .s-title br { display: none; }
    @media (max-width: 640px) { .s-title br { display: inline; } }
  </style>
  <h1 class="s-title">你的指尖，<br />有改变世界的力量。</h1>
  <p class="s-poem-line">
      百工竞巧卷八荒，太仓一粟对苍茫。<br />
      有涯欲逐无涯尽，新见方生旧说亡。<br />
      北辕适楚马徒健，樗散何妨老道旁。<br />
      莫笑汗漫无功返，浮桴终可问津梁。
    </p>
  <h2>最近写的</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <time datetime={dateOf(post).toISOString()}>{fmt(dateOf(post))}</time>
        <a href={`/posts/${slugOf(post)}/`}>{String((post.data as any).title || slugOf(post))}</a>
      </li>
    ))}
  </ul>
  <p style="margin-top:2em"><a href="/archive/">全部文章 →</a></p>
</BaseLayout>
