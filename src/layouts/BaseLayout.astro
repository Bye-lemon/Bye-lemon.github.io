---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; current?: string; wide?: boolean; }
const { title, description = '李英平的博客：自动驾驶、嵌入式与系统工具的开发笔记。', current = '', wide = false } = Astro.props;
const nav = [{"href":"/","label":"Articles"},{"href":"/archive/","label":"Archive"},{"href":"/models/","label":"Models"},{"href":"/notes/","label":"Notes"},{"href":"/nav/","label":"Sites"},{"href":"/friends/","label":"Friends"},{"href":"/about/","label":"About"}];
const fullTitle = title ? `${title} · 李英平` : '李英平';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/et-book/et-book-roman-old-style-figures.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="theme-color" content="#fbfaf6" />
    <link rel="stylesheet" href="/css/neozhisong.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="李英平" href="/rss.xml" />
  </head>
  <body class:list={[{ wide }]}>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/">Li Yingping</a>
        <nav class="site">
          {nav.map((item) => (
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="nav-search" id="search-open" type="button" aria-label="搜索" title="搜索"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></button>
          <a class="nav-icon" href="/rss.xml" aria-label="RSS" title="RSS"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"></circle></svg></a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="inner footer-inner">
        <p>本博客版权除特别说明和引用内容外，均以<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">知识共享署名 4.0 国际许可协议（CC BY 4.0）</a>进行许可。Li Yingping 2020 – 2026。</p>
        <p>使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，灵感源自 <a href="https://edwardtufte.github.io/tufte-css/" target="_blank" rel="noopener">Tufte CSS</a></p>
        <p class="footer-keep">Keep it simple and stupid.</p>
      </div>
    </footer>

    <div class="search-modal" id="search-modal" hidden>
      <div class="search-backdrop" data-search-close></div>
      <div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索">
        <div class="search-head">
          <input id="search-input" type="search" placeholder="搜索文章、模型与导航…" autocomplete="off" spellcheck="false" />
          <button class="search-close" type="button" data-search-close aria-label="关闭搜索">✕</button>
        </div>
        <p class="search-status" id="search-status" aria-live="polite"></p>
        <div class="search-results" id="search-results"></div>
      </div>
    </div>

    <script>
      (() => {
        const modal = document.getElementById('search-modal');
        const openBtn = document.getElementById('search-open');
        const input = document.getElementById('search-input');
        const resultsEl = document.getElementById('search-results');
        const statusEl = document.getElementById('search-status');
        if (!modal || !input) return;

        let docs = null, dict = null, index = null, loading = null;
        const ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ESC[c]);
        const host = (u) => { try { return new URL(u).host.replace(/^www\./, ''); } catch (e) { return u; } };

        async function ensure() {
          if (index) return;
          if (loading) return loading;
          loading = (async () => {
            const data = await (await fetch('/search.json')).json();
            docs = data.docs;
            dict = new Set(data.dict);
            const { Index } = await import('flexsearch');
            index = new Index({ encode: (s) => String(s).toLowerCase().split(/\s+/).filter(Boolean) });
            docs.forEach((d, i) => index.add(i, String(d.tokens || '')));
          })();
          return loading;
        }

        function segment(q) {
          const out = [];
          const re = /[\u4e00-\u9fff]+|[a-z0-9][a-z0-9+.#-]*/gi;
          for (const m of q.matchAll(re)) {
            const s = m[0];
            if (!/[\u4e00-\u9fff]/.test(s)) { out.push(s.toLowerCase()); continue; }
            let i = 0;
            while (i < s.length) {
              let hit = null;
              for (let n = Math.min(4, s.length - i); n >= 2; n--) {
                const cand = s.slice(i, i + n);
                if (dict.has(cand)) { hit = cand; break; }
              }
              if (hit) { out.push(hit); i += hit.length; } else { i += 1; }
            }
          }
          return [...new Set(out)];
        }

        function snippet(text, q) {
          const t = String(text || '');
          const lower = t.toLowerCase();
          let i = lower.indexOf(q.toLowerCase());
          if (i === -1) {
            for (const tok of segment(q)) { i = lower.indexOf(tok.toLowerCase()); if (i > -1) break; }
          }
          if (i === -1) return t.slice(0, 90);
          const start = Math.max(0, i - 30);
          return (start > 0 ? '…' : '') + t.slice(start, start + 100) + '…';
        }

        function item(d, q) {
          const meta = d.kind === '导航' ? host(d.url) : (d.kind + (d.date ? ' · ' + d.date : ''));
          const target = d.kind === '导航' ? ' target="_blank" rel="noopener"' : '';
          const desc = d.kind === '导航' ? (d.description || '') : snippet(d.text || d.description || '', q);
          return '<div class="sr-item"><a href="' + esc(d.url) + '"' + target + '>' + esc(d.title) + '</a>' +
            '<p class="sr-meta">' + esc(meta) + '</p>' +
            (desc ? '<p class="sr-desc">' + esc(desc) + '</p>' : '') + '</div>';
        }

        function render(ids, q) {
          const nav = [], articles = [];
          for (const id of ids) (docs[id].kind === '导航' ? nav : articles).push(docs[id]);
          let html = '';
          if (articles.length) {
            html += '<section class="sr-group"><h3>文章</h3>' + articles.slice(0, 12).map((d) => item(d, q)).join('') + '</section>';
          }
          if (nav.length) {
            html += '<section class="sr-group"><h3>导航</h3>' + nav.slice(0, 12).map((d) => item(d, q)).join('') + '</section>';
          }
          resultsEl.innerHTML = html;
          statusEl.textContent = '文章 ' + articles.length + ' 条 · 导航 ' + nav.length + ' 条';
        }

        let timer;
        function run() {
          const q = input.value.trim();
          if (!q) { resultsEl.innerHTML = ''; statusEl.textContent = ''; return; }
          if (!index) { statusEl.textContent = '索引加载中…'; }
          ensure().then(() => {
            const tokens = segment(q);
            const score = new Map(), hits = new Map();
            for (const tok of tokens) {
              const list = index.search(tok, { limit: 40 });
              list.forEach((id, rank) => {
                score.set(id, (score.get(id) || 0) + (20 - rank));
                hits.set(id, (hits.get(id) || 0) + 1);
              });
            }
            const maxHits = Math.max(0, ...hits.values());
            const ids = [...score.entries()]
              .filter(([id]) => maxHits < 2 || hits.get(id) === maxHits)
              .sort((a, b) => (hits.get(b[0]) - hits.get(a[0])) || (b[1] - a[1]))
              .map(([id]) => id);
            render(ids, q);
          }).catch(() => { statusEl.textContent = '索引加载失败'; });
        }

        function open() {
          modal.hidden = false;
          document.documentElement.classList.add('search-open');
          input.focus();
          input.select();
          ensure().catch(() => {});
          if (input.value.trim()) run();
        }
        function close() {
          modal.hidden = true;
          document.documentElement.classList.remove('search-open');
          if (openBtn) openBtn.focus();
        }

        input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 120); });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { close(); return; }
          if (e.key === 'Enter') {
            const a = resultsEl.querySelector('a');
            if (a) { a.click(); if (a.target !== '_blank') close(); }
          }
        });
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); modal.hidden ? open() : close(); }
          if (e.key === 'Escape' && !modal.hidden) close();
        });
        if (openBtn) openBtn.addEventListener('click', open);
        modal.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', close));
      })();
    </script>
  </body>
</html>
