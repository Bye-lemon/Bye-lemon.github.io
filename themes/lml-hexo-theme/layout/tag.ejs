<%
  var studioTitle = "标签";
  var kana = "ことば";
-%>
<main class="main tag-page">
    <div class="page-head">
        <span class="kana"><%- kana %></span>
        <h1><%- studioTitle %></h1>
        <span class="count">共 <%= page.total %> 篇</span>
    </div>
    <ul class="page-list">
        <%_ page.posts.each(function (_post) { _%>
        <li>
            <time datetime="<%- date(_post.date, 'YYYY-MM-DD') %>"><%- date(_post.date, 'YYYY.MM.DD') %></time>
            <a href="<%- url_for(_post.path) %>"><%- _post.title || '[Untitled Post]' %></a>
            <span class="tg"><%_ if (_post.tags && _post.tags.length) { _%><%- _post.tags.limit(2).map(function (t) { return t.name; }).join(' · ') %><%_ } _%></span>
        </li>
        <%_ }) _%>
    </ul>
    <nav class="pager">
        <span><%_ if (page.prev_link) { _%><a href="<%- url_for(page.prev_link) %>">← 上一页</a><%_ } _%></span>
        <span><%_ if (page.next_link) { _%><a href="<%- url_for(page.next_link) %>">下一页 →</a><%_ } _%></span>
    </nav>
</main>
