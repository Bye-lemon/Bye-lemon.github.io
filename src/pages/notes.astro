---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPaper, sortByDate, slugOf, dateOf, tagsOf } from '../lib/posts';
const posts = sortByDate((await getCollection('posts')).filter(isPaper));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title="论文笔记" current="/notes/">
  <h1>论文笔记</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <time datetime={dateOf(post).toISOString()}>{fmt(dateOf(post))}</time>
        <a href={`/posts/${slugOf(post)}/`}>{String((post.data as any).title || slugOf(post))}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
