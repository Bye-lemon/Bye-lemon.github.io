<%
  var curPath = (page.path || '').replace(/index\.html$/, '');
  var navItems = [
    { label: '文章',    href: '/',                    test: function () { return is_home(); } },
    { label: '论文笔记', href: '/papers/',             test: function () { return curPath.indexOf('papers/') === 0 || (curPath.indexOf('categories/论文笔记') === 0); } },
    { label: '任意门',   href: '/nav/',                 test: function () { return curPath.indexOf('nav/') === 0; } },
    { label: '记录',     href: '/archives/',            test: function () { return curPath.indexOf('archives/') === 0; } },
    { label: '关于',     href: '/about/',               test: function () { return curPath.indexOf('about/') === 0; } }
  ];
  var heroTitle = (theme.studio && theme.studio.hero_title) || '';
  var heroQuote = (theme.studio && theme.studio.hero_quote) || '';
  var motto = (theme.studio && theme.studio.motto) || '';
  var mottoDate = (theme.studio && theme.studio.motto_date) || '';
  var seal = (theme.studio && theme.studio.seal) || '英平';
-%>
<header class="s-top">
  <div class="s-top-in">
    <a class="s-brand" href="<%- url_for('/') %>">
      <span class="s-seal">李</span>
      <span class="s-brand-txt">
        <span class="s-brand-name"><%- config.author || '李英平' %></span>
        <span class="s-brand-latin">LI YINGPING'S STUDIO</span>
      </span>
    </a>
    <nav class="s-nav" aria-label="主导航">
      <%_ navItems.forEach(function (item) { _%>
      <a href="<%- url_for(item.href) %>" class="<%- item.test() ? 'is-active' : '' %>"><%- item.label %></a>
      <%_ }) _%>
    </nav>
    <div class="s-tools">
      <a class="s-menu" href="<%- url_for('/search/') %>" aria-label="搜索" title="搜索">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      </a>
      <button type="button" class="s-toggle" id="s-theme-btn" aria-label="切换夜间模式">
        <svg id="s-icon-sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/></svg>
        <svg id="s-icon-moon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" style="display:none"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"/></svg>
        <span id="s-theme-label">日</span>
      </button>
    </div>
  </div>
</header>

<script>
(function () {
  var KEY = 'studio-theme';
  var root = document.documentElement;
  var darkLink = document.getElementById('studio-dark-css');

  function isDark() { return root.getAttribute('data-theme') === 'dark'; }

  function paint() {
    var btn = document.getElementById('s-theme-btn');
    var sun = document.getElementById('s-icon-sun');
    var moon = document.getElementById('s-icon-moon');
    var label = document.getElementById('s-theme-label');
    var dark = isDark();
    if (sun) sun.style.display = dark ? 'none' : '';
    if (moon) moon.style.display = dark ? '' : 'none';
    if (label) label.textContent = dark ? '夜' : '日';
    if (btn) btn.setAttribute('aria-label', dark ? '切换日间模式' : '切换夜间模式');
  }

  function setTheme(dark, persist) {
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    if (dark && !document.getElementById('studio-dark-css')) {
      var l = document.createElement('link');
      l.id = 'studio-dark-css';
      l.rel = 'stylesheet';
      l.href = '<%- url_for("css/dark.css") %>';
      document.head.appendChild(l);
    } else if (!dark) {
      var old = document.getElementById('studio-dark-css');
      if (old) old.parentNode.removeChild(old);
    }
    if (persist) { try { localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch (e) {} }
    paint();
  }

  var btn = document.getElementById('s-theme-btn');
  if (btn) {
    btn.addEventListener('click', function () { setTheme(!isDark(), true); });
  }


  window.addEventListener('resize', function () {
    if (window.innerWidth > 960) { document.body.classList.remove('s-nav-open'); }
  });

  paint();
})();
</script>