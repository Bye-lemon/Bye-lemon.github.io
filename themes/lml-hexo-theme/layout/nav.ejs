<%
  var navData = site.data.nav || [];
  var domainOf = function (u) {
    var s = String(u || '');
    s = s.replace(/^https?:\/\//i, '');
    return s.split('/')[0].replace(/^www\./, '');
  };
  var icons = {
    star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
    gem: '<path d="M6 3h12l3 5-9 13L3 8z"/><path d="M3 8h18"/><path d="m9 3-2 5 5 13 5-13-2-5"/>',
    code: '<path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/>',
    flask: '<path d="M9 3h6"/><path d="M10 3v6L4.6 18A2 2 0 0 0 6.3 21h11.4a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7 15h10"/>',
    folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
    pencil: '<path d="m4 20 3.5-.8L20 6.7a2 2 0 0 0 0-2.8l-1-1a2 2 0 0 0-2.8 0L3.8 16.5z"/><path d="M14.5 5.5 18.5 9.5"/>',
    archive: '<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/>',
    link: '<path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/>'
  };
  var iconFor = function (cls) {
    var c = String(cls || '');
    if (c.indexOf('star') > -1) return icons.star;
    if (c.indexOf('gem') > -1 || c.indexOf('brain') > -1) return icons.gem;
    if (c.indexOf('code') > -1 || c.indexOf('terminal') > -1) return icons.code;
    if (c.indexOf('flask') > -1) return icons.flask;
    if (c.indexOf('folder') > -1) return icons.folder;
    if (c.indexOf('pencil') > -1 || c.indexOf('pen') > -1) return icons.pencil;
    if (c.indexOf('archive') > -1) return icons.archive;
    return icons.link;
  };
  var countOf = function (t) {
    if (t.list) { var n = 0; t.list.forEach(function (s) { n += (s.links || []).length; }); return n; }
    return (t.links || []).length;
  };
  var total = 0;
  navData.forEach(function (t) { total += countOf(t); });

  // flatten: sections -> [{term, links}]
  var sectionsOf = function (t) {
    if (t.list) return t.list;
    return [{ term: '', links: t.links || [] }];
  };
-%>
<main class="main nav-page">
  <header class="nav-head">
    <div class="nav-head-text">
      <h1>英平的任意门</h1>
      <p class="nav-sub">常用站点导航 · <span id="nav-count"><%= total %></span> 条收藏</p>
    </div>
    <div class="nav-search">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.2-4.2"/></svg>
      <label class="nav-sr" for="nav-search">筛选站点</label>
      <input id="nav-search" type="search" placeholder="筛选站名、描述或域名" autocomplete="off" spellcheck="false">
      <kbd class="nav-kbd">/</kbd>
    </div>
  </header>

  <div class="nav-grid">
    <nav class="nav-rail" aria-label="分类">
      <a class="nav-rail-item is-active" href="#nav-top" data-group="all"><span>全部</span><b><%= total %></b></a>
      <% navData.forEach(function (t, i) { %>
      <a class="nav-rail-item" href="#g-<%= i %>" data-group="<%= i %>"><span><%= t.taxonomy %></span><b><%= countOf(t) %></b></a>
      <% }); %>
    </nav>

    <div class="nav-main" id="nav-top">
      <% navData.forEach(function (t, i) { %>
      <section class="nav-section" id="g-<%= i %>" data-group="<%= i %>">
        <h2 class="nav-section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconFor(t.icon) %></svg>
          <span><%= t.taxonomy %></span>
          <em><%= countOf(t) %></em>
        </h2>
        <% sectionsOf(t).forEach(function (s) { %>
          <% if (s.term) { %>
          <h3 class="nav-sub-title"><span><%= s.term %></span><em><%= (s.links || []).length %></em></h3>
          <% } %>
          <ul class="nav-links">
            <% (s.links || []).forEach(function (l) { %>
            <% var key = ((l.title || '') + ' ' + domainOf(l.url) + ' ' + (l.description || '')).toLowerCase(); %>
            <li class="nav-item" data-text="<%= key %>">
              <a href="<%= l.url %>" target="_blank" rel="noopener">
                <span class="nav-logo"><img loading="lazy" src="<%= l.logo %>" alt="" onerror="this.parentNode.classList.add('is-fallback');this.remove();"><i><%= (l.title || '?').slice(0, 1).toUpperCase() %></i></span>
                <span class="nav-item-title"><%= l.title %></span>
                <span class="nav-item-meta">
                  <span class="nav-item-domain"><%= domainOf(l.url) %></span>
                  <% if (l.description) { %><span class="nav-item-desc"><%= l.description %></span><% } %>
                </span>
              </a>
            </li>
            <% }); %>
          </ul>
        <% }); %>
      </section>
      <% }); %>

      <div class="nav-empty" hidden>
        <p>没有匹配的站点</p>
        <span>换个关键词试试，或按 Esc 清空筛选。</span>
      </div>
    </div>
  </div>
</main>

<style>
.nav-page{width:100%;max-width:1120px;margin:0 auto;padding:44px 0 5rem;color:var(--s-ink)}
.nav-head{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;padding-bottom:1.15rem;border-bottom:1px solid var(--s-line);margin-bottom:1.75rem}
.nav-head h1{margin:0 0 .3rem;font-family:var(--s-serif);font-size:1.6rem;font-weight:600;letter-spacing:.12em;color:var(--s-ink)}
.nav-sub{margin:0;font-size:.8rem;color:var(--s-dim)}
.nav-search{position:relative;display:flex;align-items:center;gap:.5rem;width:20rem;max-width:100%;padding:.5rem .65rem;background:var(--s-surface);border:1px solid var(--s-line);border-radius:.2rem;color:var(--s-dim);transition:border-color .2s ease}
.nav-search:focus-within{border-color:var(--s-accent)}
.nav-search input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:var(--s-ink);font-size:.84rem}
.nav-search input::placeholder{color:var(--s-faint)}
.nav-kbd{font-family:var(--s-mono);font-size:.68rem;line-height:1;padding:.2rem .3rem;color:var(--s-dim);border:1px solid var(--s-line);border-radius:.2rem}
.nav-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.nav-grid{display:grid;grid-template-columns:10.5rem minmax(0,1fr);gap:2.25rem;align-items:start}
.nav-rail{position:sticky;top:4.5rem;display:flex;flex-direction:column;gap:.1rem}
.nav-rail-item{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.42rem .6rem .42rem .7rem;border-left:2px solid transparent;border-radius:0 .2rem .2rem 0;font-size:.85rem;color:var(--s-muted);text-decoration:none;transition:color .18s ease,background .18s ease,border-color .18s ease}
.nav-rail-item b{font-weight:400;font-family:var(--s-mono);font-size:.72rem;color:var(--s-dim)}
.nav-rail-item:hover{color:var(--s-ink);background:color-mix(in srgb,var(--s-ink) 5%,transparent)}
.nav-rail-item.is-active{color:var(--s-ink);border-left-color:var(--s-accent);background:color-mix(in srgb,var(--s-accent) 9%,transparent)}
.nav-main{min-width:0;display:flex;flex-direction:column;gap:2rem}
.nav-section{scroll-margin-top:4.25rem}
.nav-section-title{display:flex;align-items:center;gap:.55rem;margin:1.2rem 0 .6rem;padding-bottom:.5rem;border-bottom:1px solid var(--s-line);font-family:var(--s-serif);font-size:1rem;font-weight:600;letter-spacing:.14em;color:var(--s-ink)}
.nav-section-title svg{width:15px;height:15px;color:var(--s-accent);flex:none}
.nav-section-title em{margin-left:.1rem;font-style:normal;font-family:var(--s-mono);font-size:.72rem;font-weight:400;color:var(--s-dim)}
.nav-sub-title{display:flex;align-items:center;gap:.45rem;margin:1rem 0 .2rem;font-size:.76rem;font-weight:400;letter-spacing:.03em;color:var(--s-dim)}
.nav-sub-title em{font-style:normal;font-family:var(--s-mono);font-size:.7rem;color:var(--s-faint)}
.nav-links{display:grid;grid-template-columns:minmax(0,1fr);gap:.05rem;margin:0;padding:0;list-style:none}
.nav-item.is-hidden{display:none}
.nav-item>a{display:grid;grid-template-columns:1.1rem 12.5rem minmax(0,1fr);gap:.7rem;align-items:center;padding:.4rem .55rem;border-radius:.2rem;color:inherit;text-decoration:none;transition:background .16s ease}
.nav-item>a:hover{background:color-mix(in srgb,var(--s-ink) 5%,transparent)}
.nav-item>a:hover .nav-item-title{color:var(--s-accent)}
.nav-logo{position:relative;display:inline-flex;align-items:center;justify-content:center;width:1.1rem;height:1.1rem;border-radius:.2rem;overflow:hidden;flex:none}
.nav-logo img{width:100%;height:100%;object-fit:contain;display:block}
.nav-logo i{display:none;font-style:normal;font-size:.64rem;font-weight:600;color:var(--s-muted);background:color-mix(in srgb,var(--s-ink) 8%,transparent);width:100%;height:100%;align-items:center;justify-content:center;text-transform:uppercase}
.nav-logo.is-fallback i{display:flex}
.nav-item-title{font-size:.865rem;color:var(--s-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-item-meta{display:flex;align-items:baseline;gap:.55rem;min-width:0}
.nav-item-domain{font-family:var(--s-mono);font-size:.745rem;color:var(--s-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:none}
.nav-item-desc{font-size:.745rem;color:var(--s-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.nav-empty{padding:3rem 0;text-align:center;color:var(--s-dim)}
.nav-empty p{margin:0 0 .3rem;font-size:.95rem;color:var(--s-muted)}
.nav-empty span{font-size:.8rem}
@media (max-width:960px){
  .nav-page{padding:24px 0 4rem}
  .nav-head{flex-direction:column;align-items:stretch;gap:.9rem}
  .nav-search{width:100%}
  .nav-grid{display:block}
  .nav-rail{position:static;flex-direction:row;gap:.35rem;overflow-x:auto;padding-bottom:.55rem;margin-bottom:1.2rem;border-bottom:1px solid var(--s-line);scrollbar-width:none}
  .nav-rail::-webkit-scrollbar{display:none}
  .nav-rail-item{white-space:nowrap;border-left:0;border-radius:2rem;background:color-mix(in srgb,var(--s-ink) 5%,transparent);padding:.3rem .7rem;flex:none}
  .nav-rail-item.is-active{border-left:0;background:color-mix(in srgb,var(--s-accent) 18%,transparent)}
  .nav-item>a{grid-template-columns:1.1rem minmax(0,1fr);row-gap:.1rem;padding:.4rem .35rem}
  .nav-item-meta{grid-column:2;flex-wrap:wrap;gap:.1rem .5rem}
  .nav-item-desc{white-space:normal}
}
</style>

<script>
(function () {
  var input = document.getElementById('nav-search');
  var items = Array.prototype.slice.call(document.querySelectorAll('.nav-item'));
  var sections = Array.prototype.slice.call(document.querySelectorAll('.nav-section'));
  var countEl = document.getElementById('nav-count');
  var emptyEl = document.querySelector('.nav-empty');
  var railItems = Array.prototype.slice.call(document.querySelectorAll('.nav-rail-item'));
  var total = items.length;
  var allRail = railItems.filter(function (r) { return r.getAttribute('data-group') === 'all'; })[0] || null;

  function setActive(rail) {
    railItems.forEach(function (x) { x.classList.remove('is-active'); });
    if (rail) rail.classList.add('is-active');
  }

  function applyFilter() {
    var q = input ? input.value.trim().toLowerCase() : '';
    var shown = 0;
    items.forEach(function (it) {
      var hit = !q || (it.getAttribute('data-text') || '').indexOf(q) > -1;
      it.classList.toggle('is-hidden', !hit);
      if (hit) shown++;
    });
    sections.forEach(function (sec) {
      var visible = sec.querySelectorAll('.nav-item:not(.is-hidden)').length > 0;
      sec.classList.toggle('is-hidden', !visible);
    });
    if (emptyEl) emptyEl.hidden = shown !== 0;
    if (countEl) countEl.textContent = q ? shown + ' / ' + total : String(total);
    document.body.classList.toggle('nav-filtering', !!q);
  }

  if (input) {
    input.addEventListener('input', applyFilter);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { input.value = ''; applyFilter(); input.blur(); }
    });
  }
  document.addEventListener('keydown', function (e) {
    var tag = (e.target && e.target.tagName) || '';
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
      e.preventDefault();
      if (input) input.focus();
    }
  });

  railItems.forEach(function (r) {
    r.addEventListener('click', function () { setActive(r); });
  });

  if ('IntersectionObserver' in window && sections.length) {
    var byGroup = {};
    railItems.forEach(function (r) { byGroup[r.getAttribute('data-group')] = r; });
    var io = new IntersectionObserver(function (entries) {
      if (window.scrollY < 120) { setActive(allRail); return; }
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        var g = en.target.getAttribute('data-group');
        if (byGroup[g]) setActive(byGroup[g]);
      });
    }, { rootMargin: '-12% 0px -72% 0px', threshold: 0 });
    sections.forEach(function (s) { io.observe(s); });
  }
  window.addEventListener('scroll', function () {
    if (window.scrollY < 120) setActive(allRail);
  }, { passive: true });
})();
</script>