---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tagsOf } from '../../lib/posts';
import { tagSlug } from '../../lib/tags';
const posts = await getCollection('posts');
const counts = new Map();
for (const p of posts) for (const t of tagsOf(p)) counts.set(t, (counts.get(t) || 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="标签" current="/tags/">
  <h1>标签</h1>
  <p class="lead">共 {tags.length} 个标签。</p>
  <div class="tags" style="gap:1em 1.4em;font-size:.9rem">
    {tags.map(([t, n]) => <a href={`/tags/${tagSlug(t)}/`}>{t} <span style="color:var(--faint)">{n}</span></a>)}
  </div>
</BaseLayout>
