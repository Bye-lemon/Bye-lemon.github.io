---
import BaseLayout from '../layouts/BaseLayout.astro';
import { friends } from '../data/friends';

const industry = friends.filter((f) => f.kind === 'industry');
const academic = friends.filter((f) => f.kind === 'academic');
const host = (url: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; } };
const academicLabel = (f: (typeof friends)[number]) => f.university + '·' + f.name + f.title;
---
<BaseLayout title="友链" current="/friends/">
  <style>
    .f-cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.4em; }
    @media (min-width: 900px) { .f-cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.2em; } }
    .f-section { margin: 0; }
    .f-section h2 { margin: 0 0 .8em; }
    .f-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .f-list li { display: flex; align-items: baseline; justify-content: space-between; gap: 1.2em; padding: .62em 0; border-bottom: 1px solid var(--line); }
    .f-list a { border: 0; text-decoration: none; font-family: var(--serif); font-size: .98rem; }
    .f-list a:hover { color: var(--accent); text-decoration: underline; }
    .f-list .f-host { font-family: var(--mono); font-size: .66rem; color: var(--faint); white-space: nowrap; }
    @media (max-width: 767px) { .f-list li { flex-wrap: wrap; gap: .2em 1em; } }
  </style>

  <h1>友链</h1>

  <div class="f-cols">
    <section class="f-section">
      <h2>产业界的朋友们</h2>
      <ul class="f-list">
        {industry.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener">{f.name}</a>
            <span class="f-host">{host(f.url)} ↗</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="f-section">
      <h2>学术界的朋友们</h2>
      <ul class="f-list">
        {academic.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener">{academicLabel(f)}</a>
            <span class="f-host">{host(f.url)} ↗</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
