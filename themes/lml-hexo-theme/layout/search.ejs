<%
  var navTotal = 0;
  (site.data.nav || []).forEach(function (t) {
    if (t.list) { t.list.forEach(function (s) { navTotal += (s.links || []).length; }); }
    else { navTotal += (t.links || []).length; }
  });
-%>
<main class="main sp-page">
    <header class="sp-head">
        <div>
            <div class="sp-eyebrow"><span>けんさく</span><span>SEARCH</span></div>
            <h1>搜索</h1>
            <p class="sp-sub"><%= site.posts.length %> 篇文章 · <%= navTotal %> 个站点 · 也可以直接去站外</p>
        </div>
        <span class="sp-seal">検</span>
    </header>

    <div class="sp-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
        <input id="sp-input" type="search" placeholder="输入关键词" autocomplete="off" spellcheck="false" aria-label="搜索">
        <button type="button" class="sp-clear" id="sp-clear" aria-label="清空">清除</button>
    </div>

    <div class="sp-engines" role="radiogroup" aria-label="搜索范围">
        <button type="button" data-engine="local">站内</button>
        <button type="button" data-engine="google" class="is-active">Google</button>
        <button type="button" data-engine="bing">必应</button>
        <button type="button" data-engine="baidu">百度</button>
        <button type="button" data-engine="yahoo">Yahoo! JAPAN</button>
        <button type="button" data-engine="arxiv">arXiv</button>
    </div>

    <div class="sp-tools" id="sp-tools">
        <div class="sp-tabs" role="tablist">
            <button type="button" data-scope="all" class="is-active">全部</button>
            <button type="button" data-scope="post">文章</button>
            <button type="button" data-scope="site">站点</button>
        </div>
        <span class="sp-count" id="sp-count"></span>
    </div>

    <div class="sp-body" id="sp-body">
        <div class="sp-empty">正在加载索引…</div>
    </div>

    <footer class="sp-foot">
        <span><kbd>/</kbd> 聚焦</span>
        <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
        <span><kbd>↵</kbd> 打开</span>
        <span><kbd>esc</kbd> 清空</span>
    </footer>
</main>