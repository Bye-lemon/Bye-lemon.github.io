---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageAliases } from '../data/aliases';
import { getCollection, render } from 'astro:content';
const [entry] = await getCollection('about');
const { Content } = entry ? await render(entry) : { Content: null };
const data = (entry?.data || {}) as any;
const now = Array.isArray(data.now) ? data.now : [];
const timeline = Array.isArray(data.timeline) ? data.timeline : [];
---
<BaseLayout title="关于" current="/about/">
  <h1>{pageAliases.about}</h1>
  <div class="prose">{Content && <Content />}</div>

  {timeline.length > 0 && (
    <section>
      <h2>经历</h2>
      <ul class="post-list about-list">
        {timeline.map((row) => (
          <li>
            <time>{row.when}</time>
            <span>{row.what}</span>
            {row.where && <span class="about-where">{row.where}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {now.length > 0 && (
    <section>
      <h2>现在在做</h2>
      <p class="about-now">{now.map((item) => item.title).join('、')}</p>
    </section>
  )}

  <style>
    .about-list li { grid-template-columns: 7.5em minmax(0, 1fr) auto; }
    .about-where { font-family: var(--sans); font-size: .78rem; color: var(--faint); white-space: nowrap; }
    .about-now { margin: 0; font-size: 1rem; }
    @media (max-width: 640px) {
      .about-list li { grid-template-columns: minmax(0, 1fr); }
      .about-where { font-size: .76rem; }
    }
  </style>
</BaseLayout>
