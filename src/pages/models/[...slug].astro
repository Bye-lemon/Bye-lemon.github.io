---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import taxonomy from '../../data/model-taxonomy.json';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const m = entry.data as any;
const fields = (taxonomy as any).fields;
const label = (field: string, value: string) => fields?.[field]?.values?.[value] ?? value;
const labels = (field: string) => (Array.isArray(m[field]) ? m[field] : []).map((v: string) => label(field, v));
const langLabel = (v: string) => label('languages', v);
const host = (url?: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return ''; } };
const fmt = (n: any) => (n === '' || n == null ? '' : Number(n).toLocaleString('zh-CN'));
const rows: [string, string][] = [
  ['类别', m.category ? label('category', m.category) : ''],
  ['任务', labels('tasks').join('、')],
  ['语言', labels('languages').map(langLabel).join('、')],
  ['输入模态', labels('modalities_in').join('、')],
  ['输出模态', labels('modalities_out').join('、')],
  ['领域', labels('domains').join('、')],
  ['模型角色', m.role ? label('role', m.role) : ''],
  ['架构', m.architecture ? label('architecture', m.architecture) : ''],
  ['训练阶段', labels('training_stage').join('、')],
  ['开放程度', m.access ? label('access', m.access) : ''],
  ['状态', m.status ? label('status', m.status) : ''],
  ['规模档位', m.size_class ? label('size_class', m.size_class) : ''],
  ['参数量', m.params],
  ['上下文长度', m.context_length ? fmt(m.context_length) + ' tokens' : ''],
  ['家族', m.family],
  ['基座', m.base],
  ['协议', m.license],
  ['作者', m.author],
  ['更新时间', m.updated],
  ['发表情况', m.published],
  ['HF 下载', fmt(m.downloads)],
  ['HF 点赞', fmt(m.likes)],
  ['HF 更新', m.hf_last_modified],
].filter(([, v]) => v) as [string, string][];
const tags: string[] = Array.isArray(m.tags) ? m.tags : [];
const collectionModels: string[] = Array.isArray(m.collection_models) ? m.collection_models : [];
const orgModels: string[] = Array.isArray(m.org_models) ? m.org_models : [];
const hfUrl = m.hf_id ? 'https://huggingface.co/' + m.hf_id : '';
---
<BaseLayout title={String(m.name)} wide>
  <p class="back"><a href="/models/">← 模型库</a></p>
  <h1>{m.name}</h1>
  <div class="model-detail">
    <dl class="model-meta">
      {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
    <div class="model-links">
      {m.link && <a href={m.link} target="_blank" rel="noopener">权重 / 主页 ↗ <span class="dim">{host(m.link)}</span></a>}
      {m.paper && <a href={m.paper} target="_blank" rel="noopener">论文 ↗ <span class="dim">{m.paper}</span></a>}
      {hfUrl && <a href={hfUrl} target="_blank" rel="noopener">Hugging Face ↗ <span class="dim">{m.hf_id}</span></a>}
    </div>
    {tags.length > 0 && <p class="model-tags">{tags.map((t) => <span class="m-tag">{t}</span>)}</p>}

    {collectionModels.length > 0 && (
      <section class="hf-list">
        <h2>集合内模型 <span class="n">{collectionModels.length}</span></h2>
        <p class="hf-source">来源：<a href={`https://huggingface.co/collections/${m.hf_collection}`} target="_blank" rel="noopener">huggingface.co/collections/{m.hf_collection} ↗</a></p>
        <ul>
          {collectionModels.map((id) => (
            <li><a href={`https://huggingface.co/${id}`} target="_blank" rel="noopener">{id}</a></li>
          ))}
        </ul>
      </section>
    )}

    {orgModels.length > 0 && (
      <section class="hf-list">
        <h2>该组织的 HF 模型 <span class="n">{orgModels.length}</span></h2>
        <p class="hf-source">来源：<a href={`https://huggingface.co/${m.hf_org}`} target="_blank" rel="noopener">huggingface.co/{m.hf_org} ↗</a></p>
        <ul>
          {orgModels.map((id) => (
            <li><a href={`https://huggingface.co/${id}`} target="_blank" rel="noopener">{id}</a></li>
          ))}
        </ul>
      </section>
    )}

    <div class="prose model-body"><Content /></div>
  </div>
  <style>
    .back { font-family: var(--sans); font-size: .74rem; margin: 0 0 1.4em; }
    .back a { text-decoration: none; color: var(--muted); }
    .model-detail { max-width: 62rem; }
    .model-meta { display: grid; grid-template-columns: 8em 1fr; gap: .45em 1.2em; font-family: var(--sans); font-size: .8rem; margin: 1.6em 0; }
    .model-meta dt { color: var(--muted); }
    .model-meta dd { margin: 0; }
    .model-links { display: flex; gap: 1.4em; flex-wrap: wrap; font-family: var(--sans); font-size: .8rem; margin-bottom: 1em; }
    .model-links a { text-decoration: none; }
    .model-links .dim { color: var(--muted); font-size: .72rem; }
    .model-tags { margin: 0 0 1.8em; }
    .model-body { max-width: 52rem; }
    .hf-list { margin: 2em 0 1em; max-width: 62rem; }
    .hf-list h2 { font-family: var(--serif); font-style: normal; font-size: 1.1rem; margin: 0 0 .4em; display: flex; align-items: baseline; gap: .5em; }
    .hf-list h2 .n { font-family: var(--sans); font-size: .7rem; color: var(--faint); font-weight: 400; }
    .hf-source { font-family: var(--sans); font-size: .7rem; color: var(--muted); margin: 0 0 .8em; }
    .hf-list ul { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 2em; font-family: var(--mono); font-size: .72rem; }
    .hf-list li { margin: 0 0 .3em; break-inside: avoid; }
    .hf-list a { text-decoration: none; border-bottom: 1px solid var(--line); }
    .hf-list a:hover { color: var(--accent); border-color: var(--accent); }
    @media (max-width: 767px) { .hf-list ul { columns: 1; } }
  </style>
</BaseLayout>
