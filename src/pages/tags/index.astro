---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageAliases } from '../../data/aliases';
import { getCollection } from 'astro:content';
import { tagsOf } from '../../lib/posts';
import { tagSlug } from '../../lib/tags';
const posts = await getCollection('posts');
const counts = new Map();
for (const p of posts) for (const t of tagsOf(p)) counts.set(t, (counts.get(t) || 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="标签" current="/tags/">
  <h1>{pageAliases.tags}</h1>
  <div class="tags" style="gap:.75em 1.7em;font-size:1rem">
    {tags.map(([t, n]) => <a href={`/tags/${tagSlug(t)}/`}>{t} <span style="color:var(--faint);font-size:.8em">{n}</span></a>)}
  </div>
</BaseLayout>
