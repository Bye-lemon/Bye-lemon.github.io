---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索" current="/search/">
  <h1>搜索</h1>
  <form class="search-form" onsubmit="return false">
    <input id="q" type="search" placeholder="搜索文章与模型…" autocomplete="off" aria-label="搜索" />
  </form>
  <p class="search-stat" id="stat">输入关键词开始搜索。支持中文、英文与混合查询。</p>
  <div id="results"></div>
  <script>
    import { Index } from 'flexsearch';

    /** CJK 二元分词 + 拉丁单词；FlexSearch 的内置 CJK 预设是按字切分，中文会退化成单字匹配。 */
    function encode(str) {
      const out = [];
      const re = /[\u4e00-\u9fff]+|[a-z0-9][a-z0-9+.#-]*/gi;
      for (const m of String(str).matchAll(re)) {
        const t = m[0];
        if (/^[\u4e00-\u9fff]/.test(t)) {
          if (t.length === 1) out.push(t);
          else for (let i = 0; i < t.length - 1; i++) out.push(t.slice(i, i + 2));
        } else out.push(t.toLowerCase());
      }
      return out;
    }

    let docs = null;
    let index = null;

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function terms(q) {
      return q.split(/\s+/).filter(Boolean).sort((a, b) => b.length - a.length);
    }
    function highlight(text, q) {
      const safe = escapeHtml(text);
      const list = [...new Set([q, ...terms(q)])].filter((t) => t.length > 0);
      if (!list.length) return safe;
      const re = new RegExp('(' + list.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'gi');
      return safe.replace(re, '<mark>$1</mark>');
    }
    function snippet(text, q) {
      const lower = text.toLowerCase();
      let i = lower.indexOf(q.toLowerCase());
      if (i === -1) {
        for (const t of terms(q)) { i = lower.indexOf(t.toLowerCase()); if (i > -1) break; }
      }
      if (i === -1) return text.slice(0, 110);
      const start = Math.max(0, i - 40);
      return (start > 0 ? '…' : '') + text.slice(start, start + 120) + '…';
    }
    async function ensureIndex() {
      if (index) return;
      docs = await (await fetch('/search.json')).json();
      index = new Index({ encode });
      docs.forEach((d, i) => index.add(i, [d.title, d.description || '', d.text || ''].join(' ')));
    }

    const input = document.getElementById('q');
    const box = document.getElementById('results');
    const stat = document.getElementById('stat');
    const empty = '输入关键词开始搜索。支持中文、英文与混合查询。';
    let timer;

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const q = input.value.trim();
        if (!q) { box.innerHTML = ''; stat.textContent = empty; return; }
        try { await ensureIndex(); }
        catch (e) { stat.textContent = '搜索索引加载失败。'; return; }
        let ids = index.search(q, { limit: 20, bool: 'and' });
        if (!ids.length) ids = index.search(q, { limit: 20 });
        stat.textContent = '找到 ' + ids.length + ' 条结果';
        box.innerHTML = ids.length
          ? ids.map((id) => {
              const d = docs[id];
              return '<div class="search-result"><h3><a href="' + d.url + '">' + highlight(d.title, q) + '</a></h3>'
                + '<p class="search-meta">' + d.kind + (d.date ? ' · ' + d.date : '') + '</p>'
                + '<p>' + highlight(snippet(d.text || d.description || '', q), q) + '</p></div>';
            }).join('')
          : '<p class="lead">没有匹配的结果。</p>';
      }, 120);
    });
  </script>
  <style>
    .search-stat { font-family: var(--sans); font-size: .76rem; color: var(--muted); margin: 0 0 1.6em; }
    .search-result h3 { margin: 0 0 .2em; }
    .search-meta { font-family: var(--sans); font-size: .7rem; color: var(--faint); margin: 0 0 .3em; }
  </style>
</BaseLayout>
