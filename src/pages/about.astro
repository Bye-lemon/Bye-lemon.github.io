---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
const [entry] = await getCollection('about');
const { Content } = entry ? await render(entry) : { Content: null };
const data = (entry?.data || {}) as any;
const profile = Array.isArray(data.profile) ? data.profile : [];
const now = Array.isArray(data.now) ? data.now : [];
const timeline = Array.isArray(data.timeline) ? data.timeline : [];
---
<BaseLayout title="关于" current="/about/">
  <h1>关于</h1>
  <div class="prose">{Content && <Content />}</div>

  {profile.length > 0 && (
    <section>
      <h2>简历</h2>
      <dl style="margin:0;display:grid;grid-template-columns:6em 1fr;gap:.5em 1em;font-family:var(--sans);font-size:.82rem">
        {profile.map((row) => (<><dt style="color:var(--muted)">{row.k}</dt><dd style="margin:0">{row.v}</dd></>))}
      </dl>
    </section>
  )}

  {now.length > 0 && (
    <section>
      <h2>现在在做什么</h2>
      {now.map((item) => (
        <p><strong>{item.title}</strong><br /><span style="color:var(--muted)">{item.text}</span></p>
      ))}
    </section>
  )}

  {timeline.length > 0 && (
    <section>
      <h2>走过的路</h2>
      <ul class="post-list">
        {timeline.map((row) => (
          <li><time>{row.when}</time><span>{row.what}</span><span style="font-family:var(--sans);font-size:.72rem;color:var(--muted);margin-left:auto">{row.where || ''}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="about-poem">
    <h2>拟古</h2>
    <p>
      百工竞巧卷八荒，<br />
      太仓一粟对苍茫。<br />
      有涯欲逐无涯尽，<br />
      新见方生旧说亡。<br />
      北辕适楚马徒健，<br />
      樗散何妨老道旁。<br />
      莫笑汗漫无功返，<br />
      浮桴终可问津梁。
    </p>
  </section>
  <style>
    .about-poem { margin: 3em 0 0; padding-top: 2em; border-top: 1px solid var(--line); }
    .about-poem h2 { font-family: var(--serif); font-style: normal; font-size: 1rem; letter-spacing: .3em; color: var(--muted); margin: 0 0 1.2em; }
    .about-poem p { font-size: 1.08rem; line-height: 2.1; letter-spacing: .06em; margin: 0; }
  </style>
</BaseLayout>
