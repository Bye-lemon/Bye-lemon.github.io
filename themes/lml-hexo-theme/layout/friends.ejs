<%
  var list = [];
  var cfg = theme.friends || {};
  Object.keys(cfg).forEach(function (name) {
    var url = cfg[name];
    if (!url) return;
    if (url.indexOf('//') === 0) url = 'https:' + url;
    if (!/^https?:/i.test(url)) url = 'https://' + url;
    list.push({ name: String(name).replace(/<br\s*\/?>/gi, '').trim(), url: url });
  });
-%>
<main class="main friends-page">
    <div class="page-head">
        <span class="kana">ゆうれん</span>
        <h1>友链</h1>
        <span class="count">共 <%= list.length %> 位</span>
    </div>
    <p class="page-lede">一些长期在读的博客，和写它们的人。</p>
    <ul class="friends-list">
        <%_ list.forEach(function (f) { _%>
        <li>
            <a href="<%- f.url %>" target="_blank" rel="noopener">
                <span class="friends-name"><%- f.name %></span>
                <span class="friends-url"><%- f.url.replace(/^https?:\/\//, '') %></span>
            </a>
        </li>
        <%_ }) _%>
    </ul>
</main>
