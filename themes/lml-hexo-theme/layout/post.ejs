<main class="main post-page">
    <%_ var _mobileToc = toc(page.content, {list_number: true}); _%>
    <%_ if (/<li/.test(_mobileToc)) { _%>
    <details class="s-toc-mobile">
        <summary>目录</summary>
        <%- _mobileToc %>
    </details>
    <%_ } _%>
    <article class="article-entry">
        <%- page.content %>
    </article>
    <!-- license -->
    <%_ if(theme.copyright.enable === true && page.copyright !== false) { _%>
        <div class="license-wrapper">
            <%_ if(page.translated) { _%>
            <p><%- __('translater') %>：<a href="<%- config.url %>"><%- config.author %></a>
                <p><%- __('original_post_author') %>：<%- page.translated.author %>
                <p><%- __('original_post_link') %>：<a href="<%- page.translated.link %>" target="_blank"><%- page.translated.title || page.translated.link %></a>
            <%_ } else { _%>
            <p><%- __('author') %>：<a href="<%- config.url %>"><%- config.author %></a>
            <%_ } _%>
            <p><%- __('post_link') %>：<a href="<%- page.permalink %>"><%- page.permalink %></a>
            <p><%- __('publish_date') %>：<a href="<%- page.permalink %>"><%- (page.date).format('MMMM Do YYYY, h:mm:ss a') %></a>
            <p><%- __('update_date') %>：<a href="<%- page.permalink %>"><%- (page.updated).format('MMMM Do YYYY, h:mm:ss a') %></a>
            <p><%- __('license') %>：<%- theme.copyright.license %></p>
        </div>
    <%_ } _%>
    <!-- paginator -->
    <%_ if (page.prev || page.next) { _%>
    <ul class="post-paginator">
        <%_ if (page.next){ _%>
        <li class="previous">
            <div class="prevSlogan">← 上一篇</div>
            <a href="<%- url_for(page.next.path) %>" title="<%- page.next.title %>">
                <div class="prevTitle"><%- page.next.title || '[Untitled Post]' %></div>
            </a>
        </li>
        <%_ } _%>
        <%_ if (page.prev){ _%>
        <li class="next">
            <div class="nextSlogan">下一篇 →</div>
            <a href="<%- url_for(page.prev.path) %>" title="<%- page.prev.title %>">
                <div class="nextTitle"><%- page.prev.title || '[Untitled Post]' %></div>
            </a>
        </li>
        <%_ } _%>
    </ul>
    <%_ } _%>
    <!-- timeliness note -->
    <!-- idea from: https://hexo.fluid-dev.com/posts/hexo-injector/#%E6%96%87%E7%AB%A0%E6%97%B6%E6%95%88%E6%80%A7%E6%8F%90%E7%A4%BA -->
    <%_ if (theme.outdated_threshold !== undefined && theme.outdated_threshold.enable && page.timeliness !== false && (!theme.outdated_threshold.specify_article || page.timeliness)) { _%>
        <script>
            (function () {
                const time = document.getElementsByClassName('post-intro-time')[0]
                const post = document.getElementsByTagName("article")[0]
                if (time === undefined || post === undefined) {
                    return
                }

                const pubTime = new Date(time.innerText)
                const now = Date.now()
                const interval = parseInt(now - pubTime)
                const days = parseInt(interval / 86400000)
                const outdated_threshold = parseInt(<%- theme.outdated_threshold.days %>)
                if (interval > outdated_threshold * 24 * 3600 * 1000) {
                    post.innerHTML = '<div class="note note-warning">' +
                    `<div class="title">文章时效性提示</div><p>这是一篇发布于 ${days} 天前的文章，部分信息可能已发生改变，请注意甄别。` +
                    '</p></div>' + post.innerHTML;
                }
            })();
        </script>
    <%_ } _%>
    <!-- Mathjax -->
    <%_ if (page.mathjax === true) { _%>
        <%- partial('_partial/math/mathjax') %>
    <%_ } _%>
</main>
<script>
(function alignCodeBlocks() {
    var entry = document.querySelector('.article-entry');
    if (!entry) return;
    function normalize() {
        var entryRect = entry.getBoundingClientRect();
        var ref = entry.querySelector('p');
        var base = ref ? ref.getBoundingClientRect().left : entryRect.left;
        var target = entryRect.right - base;
        Array.prototype.forEach.call(entry.querySelectorAll('.highlight'), function (el) {
            el.style.marginLeft = '';
            el.style.width = '';
            var left = el.getBoundingClientRect().left;
            var shift = left - base;
            if (Math.abs(shift) > 0.5 || Math.abs(el.getBoundingClientRect().width - target) > 1) {
                el.style.marginLeft = (-shift) + 'px';
                el.style.width = target + 'px';
            }
        });
    }
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(normalize);
    normalize();
    var timer;
    window.addEventListener('resize', function () {
        clearTimeout(timer);
        timer = setTimeout(normalize, 150);
    });
})();
</script>
<script>
(function () {
    var entry = document.querySelector('.article-entry');
    if (!entry) return;
    var imgs = entry.querySelectorAll('p > img');
    Array.prototype.forEach.call(imgs, function (img) {
        var rawAlt = img.getAttribute('alt') || '';
        var altIsUseful = rawAlt && rawAlt.length <= 60 &&
            !/^image[-_]?\d/i.test(rawAlt) &&
            !/\.(png|jpe?g|gif|webp|svg)$/i.test(rawAlt) &&
            !/^\d{6,}/.test(rawAlt);
        var cap = img.getAttribute('title') || (altIsUseful ? rawAlt : '');
        var p = img.parentNode;
        if (!cap) { img.style.display = 'block'; img.style.margin = '24px auto'; return; }
        var fig = document.createElement('figure');
        fig.className = 's-figure';
        p.replaceChild(fig, img);
        fig.appendChild(img);
        var fc = document.createElement('figcaption');
        fc.textContent = cap;
        fig.appendChild(fc);
        if (!p.childNodes.length || !p.textContent.trim()) {
            if (p.parentNode) p.parentNode.removeChild(p);
        }
    });
})();
</script>
