---
interface Props { to: string; title?: string }
const { to, title = '页面已迁移' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>{title}</title>
  </head>
  <body style="font-family:serif;padding:3rem;line-height:1.7">
    <p>这个页面已经搬家：<a href={to}>{to}</a></p>
  </body>
</html>
